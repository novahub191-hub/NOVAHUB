-- [[ NOVA Hub - Custom UI Edition ]]
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local DISCORD_LINK = "https://discord.gg/678vek3Jh"
local SHORT_DISCORD_LINK = "discord.gg/678vek3Jh"

-- Safe GUI Parent Setup
local ParentTarget
pcall(function()
    ParentTarget = game:GetService("CoreGui")
end)
if not ParentTarget then
    ParentTarget = LocalPlayer:WaitForChild("PlayerGui")
end

-- Clear Old UI
if ParentTarget:FindFirstChild("NOVA_Hub_CustomUI") then
    ParentTarget.NOVA_Hub_CustomUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "NOVA_Hub_CustomUI"
ScreenGui.ResetOnSpawn = false
pcall(function() ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
ScreenGui.Parent = ParentTarget

---------------------------------------------------------
