-- Action Button Click (Copy Link & Notify)
FollowBtn.MouseButton1Click:Connect(function()
    pcall(function()
        if setclipboard then
            setclipboard(SHORT_DISCORD_LINK)
        end
    end)
    
    -- แจ้งเตือนขึ้นว่า คัดลอกลิ้งค์แล้ว!
    NotifyLabel.Text = "คัดลอกลิ้งค์แล้ว!"
    task.wait(2)
    NotifyLabel.Text = ""
end)
