-- 4. เมนูระบบ (ESP หลุมดำ + ESP ไข่เชอรูบ)
---------------------------------------------------------
local ESP_Blackhole_Active = false
local ESP_Cherub_Active = false

local ESP_Folder = Instance.new("Folder")
ESP_Folder.Name = "NOVA_ESP_Holder"
ESP_Folder.Parent = ParentTarget

local function CreateESPLabel(targetPart, text, textColor)
    if not targetPart or not targetPart.Parent then return end
    
    local tagID = "ESP_Tag_" .. targetPart:GetDebugId()
    if ESP_Folder:FindFirstChild(tagID) then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = tagID
    bb.Adornee = targetPart
    bb.Size = UDim2.new(0, 300, 0, 70)
    bb.AlwaysOnTop = true
    bb.ExtentsOffset = Vector3.new(0, 4, 0)
    bb.Parent = ESP_Folder

    local dLbl = Instance.new("TextLabel")
    dLbl.Name = "DistLbl"
    dLbl.Size = UDim2.new(1, 0, 0.3, 0)
    dLbl.BackgroundTransparency = 1
    dLbl.Text = "[Calculating...]"
    dLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    dLbl.TextSize = 14
    dLbl.Font = Enum.Font.SourceSansBold
    dLbl.Parent = bb

    local nLbl = Instance.new("TextLabel")
    nLbl.Size = UDim2.new(1, 0, 0.7, 0)
    nLbl.Position = UDim2.new(0, 0, 0.3, 0)
    nLbl.BackgroundTransparency = 1
    nLbl.Text = text
    nLbl.TextColor3 = textColor
    nLbl.TextSize = 22
    nLbl.Font = Enum.Font.SourceSansBold
    nLbl.Parent = bb

    local s2 = Instance.new("UIStroke")
    s2.Color = Color3.fromRGB(0, 0, 0)
    s2.Thickness = 3
    s2.Parent = nLbl

    task.spawn(function()
        while bb and bb.Parent and targetPart and targetPart.Parent do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = math.floor((hrp.Position - targetPart.Position).Magnitude)
                dLbl.Text = "[" .. tostring(dist) .. " Studs]"
            end
            task.wait(0.3)
        end
    end)
end

local function IsInGarden(instance)
    local p = instance.Parent
    while p and p ~= workspace do
        local pName = p.Name:lower()
        if pName:find("plot") or pName:find("garden") or pName:find("farm") or pName:find("สวน") or pName:find("player") then
            return true
        end
        p = p.Parent
    end
    return false
end

local function GetTargetPart(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function CheckAndAddESP(v)
    if not v or IsInGarden(v) then return end

    local n = v.Name:lower()
    local targetPart = GetTargetPart(v)

    if targetPart then
        if ESP_Blackhole_Active then
            if n:find("black") or n:find("hole") or n:find("หลุมดำ") or n:find("void") then
                CreateESPLabel(targetPart, "ไข่หลุมดำ!", Color3.fromRGB(0, 0, 0))
            end
        end

        if ESP_Cherub_Active then
            if n:find("cherub") or n:find("เชอรูบ") or n:find("1t") or n:find("1 t") or n:find("admin") or n:find("แอดมิน") then
                CreateESPLabel(targetPart, "ไข่เชอรูบ!", Color3.fromRGB(0, 170, 255))
            end
        end
    end
end

local function UpdateAllESP()
    ESP_Folder:ClearAllChildren()
    if not (ESP_Blackhole_Active or ESP_Cherub_Active) then return end

    for _, v in pairs(workspace:GetDescendants()) do
        CheckAndAddESP(v)
    end
end

workspace.DescendantAdded:Connect(function(v)
    if ESP_Blackhole_Active or ESP_Cherub_Active then
        task.wait(0.3)
        CheckAndAddESP(v)
    end
end)

